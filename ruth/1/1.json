{"tier":"glm-5.2","verse":1,"ref":"ruth 1:1","book":"ruth","lang":"ml","chapter":1,"translation":"വിധികർത്താക്കൾ വിധിച്ചിരുന്ന ദിവസങ്ങളിൽ ആയിരിക്കെ, ദേശത്ത് ഒരു ക്ഷാമം ഉണ്ടായി; ബേത്-ലെഖെം യെഹൂദയിൽ നിന്ന് ഒരു പുരുഷൻ മോആബ് പുരങ്ങളിൽ താമസിക്കാൻ പോയി — അവൻ, അവന്റെ ഭാര്യ, അവന്റെ രണ്ട് മക്കൾ.","tokens":[{"surface":"ויהי","gloss":"ആയിരിക്കെ"},{"surface":"בימי","gloss":"ദിവസങ്ങളിൽ"},{"surface":"שפט","gloss":"വിധിച്ചിരുന്ന"},{"surface":"השפטים","gloss":"വിധികർത്താക്കൾ"},{"surface":"ויהי","gloss":"ഉണ്ടായി"},{"surface":"רעב","gloss":"ക്ഷാമം"},{"surface":"בארץ","gloss":"ദേശത്ത്"},{"surface":"וילך","gloss":"പോയി"},{"surface":"איש","gloss":"ഒരു പുരുഷൻ"},{"surface":"מבית","gloss":"…ഇൽ നിന്ന്"},{"surface":"לחם","gloss":"ബേത്-ലെഖെം"},{"surface":"יהודה","gloss":"യെഹൂദ"},{"surface":"לגור","gloss":"താമസിക്കാൻ"},{"surface":"בשדי","gloss":"പുരങ്ങളിൽ"},{"surface":"מואב","gloss":"മോആബ്"},{"surface":"הוא","gloss":"അവൻ"},{"surface":"ואשתו","gloss":"അവന്റെ ഭാര്യ"},{"surface":"ושני","gloss":"രണ്ട്"},{"surface":"בניו","gloss":"അവന്റെ മക്കൾ"}],"timestamp":"2026-08-22T17:06:17.886273043Z","model":"glm-5.3"}