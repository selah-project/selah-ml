{"tier":"glm-5.2","verse":16,"ref":"numbers 11:16","book":"numbers","lang":"ml","chapter":11,"translation":"യാഹ്‌വെ മോശെയോടു പറഞ്ഞു: യിസ്രായേലിന്റെ മുതിർന്നവരിൽ എഴുപതു പുരുഷന്മാരെ എനിക്കു വേണ്ടി കൂട്ടുക — നീ അറിയുന്നവർ, അവർ ജനത്തിന്റെ മുതിർന്നവരും അതിന്റെ മേൽക്കൽപ്പുകാരും ആകുന്നു; അവരെ സമാഗമന-കൂടാരത്തിലേക്കു കൊണ്ടുപോകുക, അവർ അവിടെ നിന്നോടുകൂടെ നിലക്കുക.","tokens":[{"surface":"ויאמר","gloss":"പറഞ്ഞു"},{"surface":"יהוה","gloss":"യാഹ്‌വെ"},{"surface":"אל","gloss":"…നോടു"},{"surface":"משה","gloss":"മോശെയോടു"},{"surface":"אספה","gloss":"കൂട്ടുക"},{"surface":"לי","gloss":"എനിക്കു വേണ്ടി"},{"surface":"שבעים","gloss":"എഴുപതു"},{"surface":"איש","gloss":"പുരുഷന്മാരെ"},{"surface":"מזקני","gloss":"മുതിർന്നവരിൽ"},{"surface":"ישראל","gloss":"യിസ്രായേലിന്റെ"},{"surface":"אשר","gloss":"—"},{"surface":"ידעת","gloss":"നീ അറിയുന്നവർ"},{"surface":"כי","gloss":"—"},{"surface":"הם","gloss":"അവർ"},{"surface":"זקני","gloss":"മുതിർന്നവരും"},{"surface":"העם","gloss":"ജനത്തിന്റെ"},{"surface":"ושטריו","gloss":"അതിന്റെ മേൽക്കൽപ്പുകാരും"},{"surface":"ולקחת","gloss":"കൊണ്ടുപോകുക"},{"surface":"אתם","gloss":"⟨את⟩","marks":"അവരെ"},{"surface":"אל","gloss":"…ലേക്കു"},{"surface":"אהל","gloss":"കൂടാരത്തിലേക്കു"},{"surface":"מועד","gloss":"സമാഗമന-"},{"surface":"והתיצבו","gloss":"നിലക്കുക"},{"surface":"שם","gloss":"അവിടെ"},{"surface":"עמך","gloss":"നിന്നോടുകൂടെ"}],"timestamp":"2026-08-22T10:31:37.838778526Z","model":"glm-5.3"}